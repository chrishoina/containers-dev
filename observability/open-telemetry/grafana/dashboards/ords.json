{
  "uid": "ords-observability",
  "title": "ORDS observability",
  "description": "Local OpenTelemetry metrics and runtime logs from the ORDS service. HTTP and JVM metrics can be populated by the included health-check route; UCP metrics need a database-backed ORDS request.",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["ORDS", "OpenTelemetry"],
  "timezone": "browser",
  "refresh": "10s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate by status",
      "description": "Completed ORDS HTTP requests per second, grouped by response status code. Generate requests and wait for metrics to export.",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{service_name=\"ords\"}[$__rate_interval]))", "legendFormat": "{{http_response_status_code}}", "range": true}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 2,
      "title": "HTTP p95 latency",
      "description": "95th percentile time for an ORDS HTTP request, in seconds. For example, p95 = 0.2 means 95% of requests completed in 0.2 seconds or less.",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"ords\"}[$__rate_interval])))", "legendFormat": "p95", "range": true}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 3,
      "title": "UCP connections",
      "description": "Connections in the ORDS Universal Connection Pool, grouped by pool state. This needs a REST request that accesses the database; the public-properties health-check route does not borrow a connection.",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (state) (db_client_connections_usage{service_name=\"ords\"})", "legendFormat": "{{state}}", "range": true}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 4,
      "title": "UCP pending requests",
      "description": "Number of requests waiting for an ORDS pooled database connection. This is normally zero at low demo traffic and needs database-backed requests.",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(db_client_connections_pending_requests{service_name=\"ords\"})", "legendFormat": "pending", "range": true}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 5,
      "title": "JVM memory",
      "description": "Memory used by the Java Virtual Machine (JVM) that runs ORDS, split by memory area.",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (jvm_memory_type) (jvm_memory_used_bytes{service_name=\"ords\"})", "legendFormat": "{{jvm_memory_type}}", "range": true}],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 6,
      "title": "JVM CPU",
      "description": "Recent CPU utilization reported by the ORDS JVM. A value of 0.5 represents about 50% utilization.",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(jvm_cpu_recent_utilization_ratio{service_name=\"ords\"})", "legendFormat": "CPU", "range": true}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 7,
      "title": "ORDS runtime logs",
      "description": "Java Util Logging (JUL) runtime records exported by the agent. HTTP access-log files are separate and are not collected by this setup.",
      "type": "logs",
      "gridPos": {"x": 0, "y": 24, "w": 24, "h": 10},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"refId": "A", "expr": "{service_name=\"ords\"}", "queryType": "range"}],
      "options": {"showTime": true, "showLabels": false, "sortOrder": "Descending", "wrapLogMessage": true}
    }
  ]
}
